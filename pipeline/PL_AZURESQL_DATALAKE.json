{
	"name": "PL_AZURESQL_DATALAKE",
	"properties": {
		"activities": [
			{
				"name": "CPY_AZURESQL_DATALAKE",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@select * from @{pipeline().parameters.schema}.@{pipeline().parameters.schema} where @{pipeline().parameters.cdc_col} > ",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "DS_AZURE_SQL",
						"type": "DatasetReference"
					}
				]
			},
			{
				"name": "last_cdc",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"dataset": {
						"referenceName": "cdc_json",
						"type": "DatasetReference",
						"parameters": {
							"container": {
								"value": "@pipeline().parameters.schema",
								"type": "Expression"
							},
							"folder": {
								"value": "@pipeline().parameters.table",
								"type": "Expression"
							},
							"cdc_col": {
								"value": "@pipeline().parameters.cdc_col",
								"type": "Expression"
							}
						}
					}
				}
			}
		],
		"parameters": {
			"schema": {
				"type": "string"
			},
			"table": {
				"type": "string"
			},
			"cdc_col": {
				"type": "string"
			}
		},
		"annotations": []
	}
}